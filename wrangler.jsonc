{
  "name": "madar-physics",
  "compatibility_date": "2026-08-24",
  "main": "worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // قاعدة بيانات بسيطة لتتبع أجهزة كل كود اشتراك (حد جهازين لكل كود).
  // أُنشئت وربطت تلقائياً عبر لوحة Cloudflare (CODE_USAGE).
  "kv_namespaces": [
    {
      "binding": "CODE_USAGE",
      "id": "a5c90364151f482a886f06031594fcbe"
    }
  ]
}
