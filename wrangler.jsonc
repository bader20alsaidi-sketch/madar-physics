{
  "name": "madar-physics",
  "compatibility_date": "2026-08-24",
  "main": "worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // قاعدة بيانات لوحة المتصدرين لألعاب مدار (D1)
  "d1_databases": [
    {
      "binding": "LEADERBOARD",
      "database_name": "madar-leaderboard",
      "database_id": "323a75d7-71ca-4bc8-aead-dcbced93b5dc"
    }
  ]
}
